# Qdrant Configuration
# Gunakan http://localhost:6333 jika menjalankan Qdrant Docker/Server
# Atau biarkan kosong / :memory: untuk mode lokal in-memory/file
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=Healthcare_MedQuAD
QDRANT_STORAGE_PATH=./qdrant_storage

# Embedding Model
# Rekomendasi: paraphrase-multilingual-MiniLM-L12-v2 (ringan) atau paraphrase-multilingual-mpnet-base-v2
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM Configuration
# OLLAMA (Lokal)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Emergency Triage
EMERGENCY_COUNTRY_CODE=ID
EMERGENCY_HOTLINE=119
POLICE_HOTLINE=110
NATIONAL_EMERGENCY=112

# Hospital Finder Settings
HOSPITAL_SEARCH_RADIUS_KM=5.0
